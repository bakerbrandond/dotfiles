#! /bin/sh

# bspwm starts with the bare system PATH; homebrew tools (feh) and
# ~/.local/bin scripts (bspdd.sh) are invisible without this.
export PATH="$HOME/.local/bin:/home/linuxbrew/.linuxbrew/bin:$PATH"

# source the colors.
. "/home/bbd/.cache/wal/colors.sh"

# Set the border colors.
bspc config border_radius 26.0
bspc config normal_border_color "$color1"
bspc config active_border_color "$color3"
bspc config focused_border_color "$color15"
bspc config presel_feedback_color "$color3"

xsetroot -cursor_name left_ptr &

pgrep -x sxhkd > /dev/null || sxhkd &

# Monitor layout is managed by autorandr; desktop assignment happens in
# ~/.config/autorandr/postswitch. --force so the hook runs on bspwm restart too.
bspc config remove_disabled_monitors true
bspc config remove_unplugged_monitors true
autorandr --change --force


bspc config border_width         3
bspc config window_gap          12

bspc config split_ratio          0.62
bspc config focus_follows_pointer true
bspc config pointer_modifier mod1
bspc config borderless_monocle   true
bspc config gapless_monocle      true

bspc config automatic_scheme spiral

#bspc rule -a Gimp desktop='^8' state=floating follow=on
#bspc rule -a chrome desktop='^2'
bspc rule -a zathura follow=on
bspc rule -a Zoom desktop='^3' state=floating follow=on
bspc rule -a Slack desktop='^5'
bspc rule -a obs desktop='^4'
bspc rule -a discord desktop='^5'
bspc rule -a steam desktop='^5'
bspc rule -a alacritty focus=on

#bspc rule -a mplayer2 state=floating
#bspc rule -a Kupfer.py focus=on
bspc rule -a Screenkey manage=off

# WALLPAPER
feh --bg-fill /usr/share/backgrounds/Tree5160.png &

# POLYBAR
~/.config/polybar/launch.sh

# CUSTOM
# bspdd.sh deletes unoccupied desktops, which fights the static I-VI layout
# assigned in autorandr/postswitch. It only ever ran by accident (needed the
# PATH export above); leave it off.
#pgrep -u $(whoami) -f "bspdd.sh" || bspdd.sh &

# PICOM
picom -r 26 -b --config $HOME/.config/picom.conf &

# Redshift: location and temperatures come from ~/.config/redshift.conf (stowed)
pkill -x redshift && sleep 2; redshift 2>&1 &

